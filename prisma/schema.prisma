// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// 一次喂奶记录
model FeedingRecord {
  /// 主键，cuid
  id        String   @id @default(cuid())
  /// 奶量，单位毫升(ml)，可为空（仅记录时间不记录奶量时为 null）
  amount    Int?
  /// 喂奶发生的时间
  time      DateTime @default(now())
  /// 记录创建时间
  createdAt DateTime @default(now())
}

/// 一次睡眠记录
model SleepRecord {
  /// 主键，cuid
  id          String    @id @default(cuid())
  /// 入睡时间
  startTime   DateTime
  /// 醒来时间；null 表示还在睡（计时未结束）
  endTime     DateTime?
  /// 体温（℃），未量则为 null
  temperature Float?
  /// 记录创建时间
  createdAt   DateTime  @default(now())
}

/// 宝宝照片（成长相册）
model PhotoRecord {
  /// 主键，cuid
  id        String   @id @default(cuid())
  /// 缩略图 data URL（网格展示，最长边约 320px 的 JPEG）
  thumb     String
  /// 大图 data URL（查看大图，最长边 1280px 的 JPEG）
  data      String
  /// 备注，可为空
  caption   String?
  /// 拍摄/上传时间
  takenAt   DateTime @default(now())
  /// 记录创建时间
  createdAt DateTime @default(now())
}
